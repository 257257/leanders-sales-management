<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="sales_report"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="802"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20">

    <!-- Report parameters -->
    <parameter name="START_DATE" class="java.lang.String"/>
    <parameter name="END_DATE" class="java.lang.String"/>

    <!-- Fields supplied by SaleResponse -->
    <field name="id" class="java.lang.Long"/>
    <field name="customerName" class="java.lang.String"/>
    <field name="productName" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="unitPrice" class="java.math.BigDecimal"/>
    <field name="totalAmount" class="java.math.BigDecimal"/>
    <field name="saleDate" class="java.time.LocalDateTime"/>

    <!-- Sum of all sale amounts -->
    <variable name="TOTAL_SALES"
              class="java.math.BigDecimal"
              calculation="Sum">
        <variableExpression><![CDATA[$F{totalAmount}]]></variableExpression>
    </variable>

    <!-- Report title -->
    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="5" width="802" height="30"/>
                <textElement textAlignment="Center">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[SALES REPORT]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="45" width="802" height="20"/>
                <textElement textAlignment="Center">
                    <font size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Period: " + $P{START_DATE} + " to " + $P{END_DATE}
                ]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Table column headings -->
    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="45" height="25"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Sale ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="45" y="0" width="150" height="25"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Customer]]></text>
            </staticText>

            <staticText>
                <reportElement x="195" y="0" width="190" height="25"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Product]]></text>
            </staticText>

            <staticText>
                <reportElement x="385" y="0" width="55" height="25"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>

            <staticText>
                <reportElement x="440" y="0" width="110" height="25"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Unit Price]]></text>
            </staticText>

            <staticText>
                <reportElement x="550" y="0" width="120" height="25"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Total Amount]]></text>
            </staticText>

            <staticText>
                <reportElement x="670" y="0" width="132" height="25"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Sale Date]]></text>
            </staticText>

            <line>
                <reportElement x="0" y="23" width="802" height="1"/>
            </line>
        </band>
    </columnHeader>

    <!-- One row per sale -->
    <detail>
        <band height="22">
            <textField>
                <reportElement x="0" y="0" width="45" height="20"/>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="45" y="0" width="150" height="20"/>
                <textFieldExpression><![CDATA[$F{customerName}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="195" y="0" width="190" height="20"/>
                <textFieldExpression><![CDATA[$F{productName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="385" y="0" width="55" height="20"/>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.00">
                <reportElement x="440" y="0" width="110" height="20"/>
                <textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.00">
                <reportElement x="550" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{totalAmount}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="670" y="0" width="132" height="20"/>
                <textFieldExpression><![CDATA[
                    $F{saleDate} == null ? "" :
                    $F{saleDate}.toString().replace("T", " ")
                ]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Total at the end of the report -->
    <summary>
        <band height="35">
            <staticText>
                <reportElement x="0" y="5" width="550" height="25"/>
                <textElement textAlignment="Right">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL SALES:]]></text>
            </staticText>

            <textField pattern="#,##0.00">
                <reportElement x="550" y="5" width="120" height="25"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    $V{TOTAL_SALES} == null
                    ? java.math.BigDecimal.ZERO
                    : $V{TOTAL_SALES}
                ]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
